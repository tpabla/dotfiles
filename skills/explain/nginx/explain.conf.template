server {
    # Bind to the Tailscale IP (or 127.0.0.1); never 0.0.0.0.
    listen __LISTEN__;
    server_name _;
    root __EXPLAIN_HOME__;
    charset utf-8;
    # macOS + Tailscale: with sendfile on, response headers get dropped on the utun interface.
    sendfile off;
    tcp_nodelay off;

    location = / {
        return 302 /docs/;
    }

    location /docs/ {
        index index.html;
        try_files $uri $uri/ =404;
    }

    # Docs change often; always revalidate so links show the latest version.
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
    }

    location /docs/_assets/vendor/ {
        add_header Cache-Control "public, max-age=604800";
    }
}
