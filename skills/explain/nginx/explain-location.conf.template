# Explain docs as a location inside an existing server block (see SKILL.md, Hosting).
# That server needs `sendfile off; tcp_nodelay off;` on macOS + Tailscale.
location /docs/ {
    alias __EXPLAIN_HOME__/docs/;
    index index.html;
    charset utf-8;
    add_header Cache-Control "no-cache" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location /docs/_assets/vendor/ {
        alias __EXPLAIN_HOME__/docs/_assets/vendor/;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location ~ /\. {
        deny all;
    }
}
